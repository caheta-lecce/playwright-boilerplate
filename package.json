{
  "name": "playwright-boilerplate",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Reusable Playwright template with typed configuration, composed fixtures and page objects.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test --grep-invert @destructive",
    "test:ci": "playwright test --forbid-only --grep-invert @destructive",
    "test:smoke": "node scripts/run-suite.mjs smoke",
    "test:regression": "node scripts/run-suite.mjs regression",
    "test:destructive": "node scripts/run-suite.mjs destructive",
    "test:headed": "playwright test --headed --grep-invert @destructive",
    "test:debug": "playwright test --debug --grep-invert @destructive",
    "test:changed": "playwright test --only-changed --grep-invert @destructive",
    "test:changed:main": "playwright test --only-changed=main --grep-invert @destructive",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium --grep-invert @destructive",
    "test:firefox": "playwright test --project=firefox --grep-invert @destructive",
    "test:webkit": "playwright test --project=webkit --grep-invert @destructive",
    "test:zap": "npm run zap:baseline && npm run zap:reset && playwright test --config=playwright.zap.config.ts --project=zap-chromium",
    "test:zap:headed": "npm run zap:baseline && npm run zap:reset && playwright test --config=playwright.zap.config.ts --project=zap-chromium --headed",
    "test:zap:no-proxy": "playwright test --config=playwright.zap.config.ts --project=zap-chromium-no-proxy",
    "zap:baseline": "node scripts/configure-zap-baseline.mjs",
    "zap:reset": "node scripts/reset-zap-session.mjs",
    "test:list": "playwright test --list",
    "test:unit": "node --test \"unit-tests/**/*.test.mjs\"",
    "report": "playwright show-report",
    "a11y:report": "node scripts/a11y-report.mjs",
    "a11y:compare": "node scripts/a11y-compare.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "ai:skills:sync": "node scripts/sync-ai-skills.mjs",
    "ai:skills:check": "node scripts/sync-ai-skills.mjs --check",
    "guidelines:check": "node scripts/check-guidelines.mjs"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "25.9.5",
    "dotenv": "^18.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-playwright": "2.12.0",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.0",
    "zod": "4.6.5"
  }
}
