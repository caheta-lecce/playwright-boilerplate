{
  "name": "playwright-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Playwright template with typed configuration, composed fixtures and page objects.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test --grep-invert @destructive",
    "test:smoke": "node scripts/run-suite.mjs smoke",
    "test:regression": "node scripts/run-suite.mjs regression",
    "test:destructive": "node scripts/run-suite.mjs destructive",
    "test:headed": "playwright test --headed --grep-invert @destructive",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium --grep-invert @destructive",
    "test:firefox": "playwright test --project=firefox --grep-invert @destructive",
    "test:webkit": "playwright test --project=webkit --grep-invert @destructive",
    "test:list": "playwright test --list",
    "test:unit": "node --test \"unit-tests/**/*.test.mjs\"",
    "report": "playwright show-report",
    "lint": "eslint .",
    "type:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "ai:skills:sync": "node scripts/sync-ai-skills.mjs",
    "ai:skills:check": "node scripts/sync-ai-skills.mjs --check",
    "guidelines:check": "node scripts/check-guidelines.mjs"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "dotenv": "^18.0.9",
    "eslint": "10.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "globals": "17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7"
  }
}
