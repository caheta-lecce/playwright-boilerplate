{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "paths": {
      "@lib/*": ["./lib/*"],
      "@fixtures/*": ["./lib/fixtures/*"],
      "@pages/*": ["./src/pages/*"],
      "@config/*": ["./src/config/*"],
      "@shared/*": ["./src/shared/*"],
      "@data/*": ["./src/data/*"]
    }
  },
  "include": ["playwright.config.ts", "lib/**/*.ts", "src/**/*.ts"]
}
