{
  "permissions": {
    "allow": [],
    "deny": ["Read(.env)", "Edit(.env)", "Read(.env.local)", "Edit(.env.local)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/scripts/enforce-guidelines.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/scripts/format-on-write.mjs"
          }
        ]
      }
    ]
  }
}
