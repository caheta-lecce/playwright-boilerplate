# The included demo runs locally and requires no credentials.
ENV=local
BASE_URL=http://127.0.0.1:4173
# For ENV=test, replace the example page object and auth setup for your own app.

# ZAP passive-scan layer (npm run test:zap), see docs/zap/zap-proxy-scan.md. All optional.
# ZAP_PROXY_URL=http://127.0.0.1:8080
# ZAP_PROXY=off
# ZAP_KEY=
